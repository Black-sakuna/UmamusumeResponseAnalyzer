<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PluginRuntimeSmoke</AssemblyName>
    <IsUraPlugin>false</IsUraPlugin>
    <GenerateUraPluginManifestOnBuild>false</GenerateUraPluginManifestOnBuild>
    <PackageUraPluginOnBuild>false</PackageUraPluginOnBuild>
    <DeployUraPluginToLocalAppDataOnBuild>false</DeployUraPluginToLocalAppDataOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UraTestHostRoot)\eng\PluginTesting\SmokeHost.cs" Link="SmokeHost.cs" />
    <ProjectReference Include="$(UraTestHostRoot)\UmamusumeResponseAnalyzer\UmamusumeResponseAnalyzer.csproj" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\BreedersScenarioAnalyzer\BreedersScenarioAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\CookScenarioAnalyzer\CookScenarioAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\EventResponseAnalyzer\EventResponseAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\MechaScenarioAnalyzer\MechaScenarioAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\OldScenarioAnalyzer\OldScenarioAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\OnsenScenarioAnalyzer\OnsenScenarioAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\PioneerScenarioAnalyzer\PioneerScenarioAnalyzer\PioneerScenarioAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
    <ProjectReference Include="$(UraTestPluginSourcesRoot)\UAFScenarioAnalyzer\UAFScenarioAnalyzer.csproj" AdditionalProperties="GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false" />
  </ItemGroup>

</Project>
